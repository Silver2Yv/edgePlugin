{
  "manifest_version": 3,
  "name": "阅读助手 · 网络诊断包",
  "version": "0.1.0",
  "description": "原型验证用：在真实浏览器里测公司中转站的连通性、流式、长等待与 webRequest 观测。不是正式扩展。",
  "minimum_chrome_version": "141",
  "permissions": ["storage", "webRequest"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "打开网络诊断页" }
}
